# --- ApiPay.kz (приём онлайн-платежей Kaspi Pay) ---
# Получить в личном кабинете apipay.kz: Настройки → Подключение
APIPAY_API_KEY=your_apipay_api_key_here
APIPAY_WEBHOOK_SECRET=your_apipay_webhook_secret_here
APIPAY_BASE_URL=https://bpapi.bazarbay.site/api/v1

# --- Telegram Bot — заказы с сайта (server-side only, без префикса VITE_) ---
# Получить токен: @BotFather → /newbot
TG_BOT_TOKEN=your_bot_token_here

# ID чата или группы куда бот будет слать заказы
# Узнать свой chat_id: написать боту @userinfobot
TG_CHAT_ID=your_chat_id_here
